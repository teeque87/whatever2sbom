#!/bin/sh
set -e

VENV=/opt/whatever2sbom/venv
WHEELS=/opt/whatever2sbom/wheels
PLUGINS=/opt/whatever2sbom/plugins

if [ ! -d "$VENV" ]; then
    python3 -m venv "$VENV"
fi

"$VENV/bin/pip" install --no-index --find-links "$WHEELS" --upgrade whatever2sbom

# System-wide drop-in directory for custom plugins (--plugin <name>).
mkdir -p "$PLUGINS"

exit 0
